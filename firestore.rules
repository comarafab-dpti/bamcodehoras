rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. AUTENTICAÇÃO
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userEmail() {
      return isAuthenticated()
        && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // ============================================================
    // 2. ADMIN USERS
    // ============================================================

    function adminRef() {
      return /databases/$(database)/documents/admin_users/$(userEmail());
    }

    function hasAdminDoc() {
      return isAuthenticated() && userEmail() != '' && exists(adminRef());
    }

    function adminData() {
      return get(adminRef()).data;
    }

    function rawRole() {
      return hasAdminDoc()
        ? (
            adminData().get('nivelAcesso', null) != null
              ? string(adminData().get('nivelAcesso'))
              : (
                  adminData().get('role', null) != null
                    ? string(adminData().get('role'))
                    : ''
                )
          )
        : '';
    }

    function adminStatus() {
      return hasAdminDoc()
        ? (
            adminData().get('status', null) != null
              ? string(adminData().get('status'))
              : (
                  adminData().get('ativo', true) == false
                    ? 'inativo'
                    : 'ativo'
                )
          )
        : '';
    }

    function isAdminActive() {
      return hasAdminDoc()
        && adminStatus() == 'ativo'
        && rawRole() != ''
        && rawRole() != 'NENHUM';
    }

    // ============================================================
    // 3. NORMALIZAÇÃO DE PERFIS
    // ============================================================

    function normalizeRole() {
      let r = rawRole();

      return r == 'SUPER_ADMIN' ? 'SUPER_ADMIN' :
        (r == 'RH_ADMIN' || r == 'GESTOR_RH') ? 'RH_ADMIN' :
        (r == 'GERENTE_CANTEIRO' || r == 'GERENTE' || r == 'GERENTE_CAMPO' || r == 'ROLE_GERENTE') ? 'GERENTE_CANTEIRO' :
        (r == 'CHEFE_CANTEIRO' || r == 'ENCARREGADO_CANTEIRO') ? 'CHEFE_CANTEIRO' :
        (r == 'CHEFE_DA' || r == 'ENCARREGADO_DA') ? 'CHEFE_DA' :
        (r == 'AUX_DA' || r == 'AUXILIAR_DA') ? 'AUX_DA' : '';
    }

    // ============================================================
    // 4. PERFIS
    // ============================================================

    function isSuperAdmin() {
      return isAdminActive()
        && normalizeRole() == 'SUPER_ADMIN';
    }

    function isRH() {
      return isAdminActive()
        && normalizeRole() == 'RH_ADMIN';
    }

    function isGlobalAdmin() {
      return isSuperAdmin() || isRH();
    }

    function isGerenteCanteiro() {
      return isAdminActive()
        && normalizeRole() == 'GERENTE_CANTEIRO';
    }

    function isChefeCanteiro() {
      return isAdminActive()
        && normalizeRole() == 'CHEFE_CANTEIRO';
    }

    function isChefeDA() {
      return isAdminActive()
        && normalizeRole() == 'CHEFE_DA';
    }

    function isAuxDA() {
      return isAdminActive()
        && normalizeRole() == 'AUX_DA';
    }

    function isDA() {
      return isChefeDA() || isAuxDA();
    }

    // Usuários que podem realizar lançamentos.
    function podeLancar() {
      return isGlobalAdmin()
        || isGerenteCanteiro()
        || isDA();
    }

    // Usuários que podem fechar/reabrir competência.
    function podeGerenciarCompetencia() {
      return isGlobalAdmin()
        || isGerenteCanteiro()
        || isDA();
    }

    // ============================================================
    // 5. ESCOPO DE CANTEIRO
    // ============================================================

    function meuCanteiro() {
      return hasAdminDoc()
        ? string(adminData().get('canteiroSede', ''))
        : '';
    }

    /*
     * Verifica se o documento pertence ao canteiro do usuário,
     * aceitando o campo canônico (sedeCodigo) ou os legados
     * (employeeSede / sede) de forma consistente.
     */
    function documentoDoMeuCanteiro(data) {
      let meu = meuCanteiro();

      if (meu == '') {
        return false;
      }

      let sedeCodigo = data.get('sedeCodigo', '');
      let employeeSede = data.get('employeeSede', '');
      let sede = data.get('sede', '');

      return (sedeCodigo != '' && sedeCodigo == meu)
        || (employeeSede != '' && employeeSede == meu)
        || (sede != '' && sede == meu);
    }

    /*
     * Extrai o canteiro de um documento de lançamento, aceitando
     * employeeSede (padrão), sedeCodigo ou sede (canônico/legado).
     */
    function canteiroDoDocumento(data) {
      let sede = data.get('employeeSede', '');

      if (sede == '') {
        sede = data.get('sedeCodigo', '');
      }

      if (sede == '') {
        sede = data.get('sede', '');
      }

      return sede;
    }

    function canteiroPermitido(canteiro) {
      return isGlobalAdmin()
        || (
          isAdminActive()
          && canteiro != null
          && canteiro != ''
          && canteiro == meuCanteiro()
        );
    }

    /*
     * Contracheques guardam a sede em formato livre (ex: "KO-DL").
     * Perfis restritos podem operar apenas quando a sede contém
     * o código do próprio canteiro.
     */
    function contrachequeCanteiroPermitido(data) {
      if (isGlobalAdmin()) {
        return true;
      }

      let meu = meuCanteiro().lower();

      if (meu == '') {
        return false;
      }

      let sede = string(data.get('sede', '')).lower();

      return sede != '' && sede.matches('.*' + meu + '.*');
    }

    // ============================================================
    // 6. COLABORADOR / AUTOATENDIMENTO
    // ============================================================

    /*
     * MODELO DE SEGURANÇA MÍNIMA E SUFICIENTE (acordado):
     *
     * O Portal do Colaborador (/portal) não usa Firebase Auth.
     * A localização do cadastro (matrícula/CPF) e a validação da
     * senha acontecem no próprio app, lendo as coleções públicas
     * abaixo. Escritas permanecem restritas a perfis autorizados.
     */

    function isColaborador() {
      return isAuthenticated()
        && request.auth.token.get('matricula', null) != null
        && string(request.auth.token.matricula) != '';
    }

    function colaboradorMatricula() {
      return isColaborador()
        ? string(request.auth.token.matricula)
        : '';
    }

    function pertenceAoColaborador(data) {
      return isColaborador()
        && data.get('matricula', '') == colaboradorMatricula();
    }

    // ============================================================
    // 7. COMPETÊNCIAS
    // ============================================================

    function competenciaValida(competencia) {
      return competencia != null
        && competencia.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function competenciaAtual() {
      return string(request.time.year())
        + '-'
        + (
            request.time.month() < 10
              ? '0' + string(request.time.month())
              : string(request.time.month())
          );
    }

    function competenciaAnterior(competencia) {
      let partes = competencia.split('-');
      let ano = int(partes[0]);
      let mes = int(partes[1]);

      return mes == 1
        ? string(ano - 1) + '-12'
        : string(ano)
          + '-'
          + (
              mes - 1 < 10
                ? '0' + string(mes - 1)
                : string(mes - 1)
            );
    }

    function competenciaDoisMesesAtras(competencia) {
      return competenciaAnterior(
        competenciaAnterior(competencia)
      );
    }

    function competenciaTresMesesAtras(competencia) {
      return competenciaAnterior(
        competenciaDoisMesesAtras(competencia)
      );
    }

    function dentroUltimos3Meses(competencia) {
      let atual = competenciaAtual();

      return competenciaValida(competencia)
        && (
          competencia == atual
          || competencia == competenciaAnterior(atual)
          || competencia == competenciaDoisMesesAtras(atual)
        );
    }

    // ============================================================
    // 8. STATUS DA COMPETÊNCIA POR CANTEIRO
    // ============================================================

    function statusCompetenciaCanteiro(competencia, canteiro) {
      let ref =
        /databases/$(database)/documents/competencias_controle/$(competencia);

      return exists(ref)
        ? get(ref)
            .data
            .get('statusCanteiros', {})
            .get(canteiro, {})
            .get('status', 'ABERTO')
        : 'ABERTO';
    }

    function competenciaAtualAberta(canteiro) {
      return statusCompetenciaCanteiro(
        competenciaAtual(),
        canteiro
      ) == 'ABERTO';
    }

    /*
     * REGRA PRINCIPAL DE LANÇAMENTO (por canteiro):
     *
     * - competência atual precisa estar ABERTA;
     * - competência anterior do MESMO CANTEIRO precisa estar FECHADA.
     *
     * AUSÊNCIA DE CONTROLE = LIBERADO: se o documento de controle do
     * mês anterior não existir, ou se o canteiro não tiver registro no
     * mapa statusCanteiros, o lançamento é permitido (primeiro mês de
     * uso, canteiro novo, implantação). O bloqueio ocorre SOMENTE quando
     * o controle existe e o canteiro está explicitamente não-fechado.
     *
     * SUPER_ADMIN/RH continuam com acesso global.
     */
    function competenciaAnteriorFechada(canteiro) {
      let anterior = competenciaAnterior(competenciaAtual());
      let ref =
        /databases/$(database)/documents/competencias_controle/$(anterior);

      // Sem documento de controle do mês anterior = liberado
      if (!exists(ref)) {
        return true;
      }

      let controle = get(ref).data.get('statusCanteiros', {});
      let registro = controle.get(canteiro, null);

      // Canteiro sem registro no mapa = liberado
      if (registro == null) {
        return true;
      }

      return registro.get('status', 'ABERTO') == 'FECHADO';
    }

    function lancamentoCompetenciaPermitido(data) {
      let canteiro = canteiroDoDocumento(data);

      return isGlobalAdmin()
        || (
          canteiroPermitido(canteiro)
          && competenciaAtualAberta(canteiro)
          && competenciaAnteriorFechada(canteiro)
        );
    }

    function lancamentoCanteiroPermitido(data) {
      let canteiro = canteiroDoDocumento(data);

      return isGlobalAdmin()
        || (
          canteiroPermitido(canteiro)
          && competenciaAtualAberta(canteiro)
          && competenciaAnteriorFechada(canteiro)
        );
    }

    // ============================================================
    // 9. REGRAS DE LANÇAMENTOS
    // ============================================================

    match /lancamentos/{doc} {

      /*
       * Leitura pública: o Portal do Colaborador (/portal) consulta
       * lançamentos sem Firebase Auth; a senha é validada no app e a
       * tela exibe apenas os dados do colaborador autenticado.
       * Escrita permanece restrita por perfil e por competência.
       */
      allow read: if
        isGlobalAdmin()
        || (isColaborador() && pertenceAoColaborador(resource.data))
        || (
          isAdminActive()
          && (isGerenteCanteiro() || isDA())
          && documentoDoMeuCanteiro(resource.data)
        );

      // Criar lançamento
      allow create: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      // Atualizar lançamento
      allow update: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        )
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      // Excluir lançamento
      allow delete: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        );
    }

    // ============================================================
    // 10. DISPENSAS / ATESTADOS / SPTF
    // ============================================================

    match /dispensas_sptf/{doc} {

      // Perfis restritos lêem conforme o escopo do canteiro
      // (campo employeeSede gravado na emissão da guia).
      allow read: if
        isGlobalAdmin()
        || (isColaborador() && pertenceAoColaborador(resource.data))
        || (
          (isGerenteCanteiro() || isDA())
          && documentoDoMeuCanteiro(resource.data)
        );

      allow create: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow update: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        )
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow delete: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        );
    }

    // ============================================================
    // 11. CONTRACHEQUES
    // ============================================================

    match /contracheques/{doc} {

      /*
       * Leitura pública: o Portal do Colaborador exibe o
       * contracheque após validação de senha no app.
       * Perfis restritos filtram pelo próprio canteiro.
       */
      allow read: if
        isGlobalAdmin()
        || (isColaborador() && pertenceAoColaborador(resource.data))
        || (
          isAdminActive()
          && (isGerenteCanteiro() || isDA())
          && contrachequeCanteiroPermitido(resource.data)
        );

      /*
       * Importação de folha NÃO exige competência aberta/fechada:
       * contracheque é dado importado da folha, não lançamento
       * operacional do banco de horas.
       */
      allow create: if
        podeLancar()
        && contrachequeCanteiroPermitido(
          request.resource.data
        );

      allow update: if
        podeLancar()
        && contrachequeCanteiroPermitido(
          request.resource.data
        );

      allow delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 12. INSALUBRIDADE - REGISTROS
    // ============================================================

    match /insalubridade_records/{doc} {

      /*
       * Leitura pública: o Portal do Colaborador consulta os
       * apontamentos após validação de senha no app.
       */
      allow read: if
        isGlobalAdmin()
        || (isColaborador() && pertenceAoColaborador(resource.data))
        || (
          isAdminActive()
          && (isGerenteCanteiro() || isDA())
          && documentoDoMeuCanteiro(resource.data)
        );

      allow create: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow update: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        )
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow delete: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        );
    }

    // ============================================================
    // 13. INSALUBRIDADE - CONSOLIDADO
    // ============================================================

    match /insalubridade/{doc} {

      allow read: if
        isGlobalAdmin()
        || (
          (isGerenteCanteiro() || isDA())
          && documentoDoMeuCanteiro(resource.data)
        );

      allow create: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow update: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        )
        && lancamentoCompetenciaPermitido(
          request.resource.data
        );

      allow delete: if
        podeLancar()
        && lancamentoCompetenciaPermitido(
          resource.data
        );
    }

    // ============================================================
    // 14. RESUMO MENSAL
    // ============================================================

    match /resumo_mensal/{doc} {

      allow read: if
        isGlobalAdmin()
        || (
          (isGerenteCanteiro() || isDA())
          && documentoDoMeuCanteiro(resource.data)
        );

      allow create, update: if
        isGlobalAdmin();

      allow delete: if
        isSuperAdmin();
    }

    // ============================================================
    // 15. CONTROLE DE COMPETÊNCIAS
    // ============================================================

    match /competencias_controle/{doc} {

      // Usuários autenticados podem consultar o calendário/status.
      allow read: if isAuthenticated();

      allow create: if
        podeGerenciarCompetencia();

      /*
       * RH / SUPER_ADMIN:
       * podem alterar a competência globalmente.
       *
       * GERENTE/DA:
       * somente statusCanteiros do próprio canteiro.
       *
       * Não podem alterar outros campos da competência.
       */

      allow update: if
        isGlobalAdmin()

        ||

        (
          (isGerenteCanteiro() || isDA())

          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusCanteiros'])

          && request.resource.data
               .get('statusCanteiros', {})
               .diff(
                 resource.data.get('statusCanteiros', {})
               )
               .affectedKeys()
               .hasOnly([meuCanteiro()])

          && request.resource.data
               .get('statusCanteiros', {})
               .get(meuCanteiro(), {})
               .get('status', '')
               in ['ABERTO', 'FECHADO']
        );

      allow delete: if isGlobalAdmin();
    }

    // ============================================================
    // 16. CANTEIROS
    // ============================================================

    match /canteiros_obras/{doc} {

      allow read: if isAuthenticated();

      allow create, update, delete: if
        isGlobalAdmin();
    }

    match /canteiros/{doc} {

      allow read: if isAuthenticated();

      allow create, update, delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 17. UNIDADES ORGANIZACIONAIS
    // ============================================================

    match /unidades_organizacionais/{doc} {

      allow read: if isAuthenticated();

      allow create, update, delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 18. CONFIGURAÇÕES DO SISTEMA
    // ============================================================

    match /system_config/{doc} {

      allow read: if isAuthenticated();

      allow create, update, delete: if
        isGlobalAdmin();
    }

    match /institution_settings/{doc} {

      allow read: if isAuthenticated();

      allow create, update, delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 19. COLABORADORES
    // ============================================================

    /*
    * MODELO DE PORTAL COM CUSTOM TOKEN:
     *
    * A Cloud Function valida a senha e emite a claim matricula. O
    * documento retornado precisa pertencer à matrícula autenticada.
     */
    match /colaboradores/{doc} {

      allow read: if
        isGlobalAdmin()
        || (isColaborador() && pertenceAoColaborador(resource.data));

      // Somente perfis globais (RH/TI) escrevem cadastros.
      allow create, update, delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 20. CREDENCIAIS DOS COLABORADORES
    // ============================================================

    /*
    * A leitura de colaboradores_auth é exclusiva da administração.
    * A Cloud Function é a única camada que deve acessar o hash da
    * senha para emitir o Firebase Custom Token.
     */
    match /colaboradores_auth/{doc} {

      allow read: if isGlobalAdmin();

      allow create, update: if
        isGlobalAdmin();

      allow delete: if
        isGlobalAdmin();
    }

    // ============================================================
    // 21. ADMIN USERS
    // ============================================================

    /*
     * Segurança:
     *
     * - usuário comum pode consultar SOMENTE o próprio cadastro;
     * - não pode mudar o próprio perfil;
     * - não pode se promover;
     * - SUPER_ADMIN administra tudo;
     * - GERENTE pode administrar DA/AUX_DA do próprio canteiro.
     */

    match /admin_users/{userId} {

      // Super Admin consulta tudo.
      allow read: if
        isSuperAdmin()

        ||

        // RH consulta administradores.
        isRH()

        ||

        // Gerente consulta usuários do seu canteiro.
        (
          isGerenteCanteiro()
          && resource.data.get('canteiroSede', '') == meuCanteiro()
        )

        ||

        // Qualquer administrador consulta o próprio cadastro.
        (
          isAuthenticated()
          && userId.lower() == userEmail()
        );

      // SUPER_ADMIN cria usuários.
      allow create: if
        isSuperAdmin()

        ||

        /*
         * GERENTE pode criar apenas:
         * CHEFE_DA ou AUX_DA
         * dentro do próprio canteiro.
         */
        (
          isGerenteCanteiro()
          && request.resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()
          && request.resource.data.get(
               'nivelAcesso',
               request.resource.data.get('role', '')
             )
             in ['CHEFE_DA', 'ENCARREGADO_DA', 'AUX_DA', 'AUXILIAR_DA']
        );

      // Atualização
      allow update: if

        // SUPER_ADMIN pode tudo.
        isSuperAdmin()

        ||

        /*
         * RH pode administrar usuários administrativos.
         */
        isRH()

        ||

        /*
         * GERENTE pode administrar DA/AUX_DA
         * do próprio canteiro.
         */
        (
          isGerenteCanteiro()

          && resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()

          && request.resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()

          && request.resource.data.get(
               'nivelAcesso',
               request.resource.data.get('role', '')
             )
             in ['CHEFE_DA', 'ENCARREGADO_DA', 'AUX_DA', 'AUXILIAR_DA']

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               'nome',
               'telefone',
               'fotoUrl',
               'status',
               'ativo',
               'nivelAcesso',
               'role',
               'canteiroSede'
             ])
        )

        ||

        /*
         * Usuário comum pode alterar somente dados pessoais
         * permitidos, nunca seu próprio nível de acesso.
         */
        (
          isAuthenticated()

          && userId.lower() == userEmail()

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               'nome',
               'telefone',
               'fotoUrl'
             ])

          && request.resource.data.get(
               'nivelAcesso',
               resource.data.get('nivelAcesso', '')
             )
             == resource.data.get(
               'nivelAcesso',
               ''
             )

          && request.resource.data.get(
               'role',
               resource.data.get('role', '')
             )
             == resource.data.get(
               'role',
               ''
             )

          && request.resource.data.get('canteiroSede', '')
             == resource.data.get('canteiroSede', '')
        );

      // Somente SUPER_ADMIN pode excluir usuários.
      allow delete: if
        isSuperAdmin();
    }

    // ============================================================
    // 22. USUARIOS_SISTEMA
    // ============================================================

    match /usuarios_sistema/{userId} {

      allow read: if
        isSuperAdmin()
        || isRH()
        || (
          isGerenteCanteiro()
          && resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()
        )
        || (
          isAuthenticated()
          && userId.lower() == userEmail()
        );

      allow create: if
        isSuperAdmin();

      allow update: if

        isSuperAdmin()

        ||

        isRH()

        ||

        (
          isGerenteCanteiro()

          && resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()

          && request.resource.data.get(
               'canteiroSede',
               ''
             ) == meuCanteiro()

          && request.resource.data.get(
               'nivelAcesso',
               request.resource.data.get('role', '')
             )
             in ['CHEFE_DA', 'ENCARREGADO_DA', 'AUX_DA', 'AUXILIAR_DA']

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               'nome',
               'telefone',
               'fotoUrl',
               'status',
               'ativo',
               'nivelAcesso',
               'role',
               'canteiroSede'
             ])
        )

        ||

        (
          isAuthenticated()

          && userId.lower() == userEmail()

          && request.resource.data.diff(
               resource.data
             ).affectedKeys()
             .hasOnly([
               'nome',
               'telefone',
               'fotoUrl'
             ])

          && request.resource.data.get('canteiroSede', '')
             == resource.data.get('canteiroSede', '')
        );

      allow delete: if
        isSuperAdmin();
    }

    // ============================================================
    // 23. LOGS DE ACESSO
    // ============================================================

    /*
     * Criação liberada para clientes autenticados enquanto não há
     * Cloud Function dedicada. Ações do portal público (sem auth)
     * permanecem registradas apenas no cache local do navegador.
     */
    match /logs_acesso/{doc} {

      allow read: if
        isGlobalAdmin();

      allow create: if
        isAuthenticated();

      allow update, delete: if
        isSuperAdmin();
    }

    // ============================================================
    // 24. LOGS DE AUDITORIA
    // ============================================================

    /*
     * Criação liberada para clientes autenticados (trilha de
     * auditoria gravada pelo app de gestão). Históricos permanecem
     * imutáveis: ninguém edita ou apaga.
     */
    match /logs_auditoria/{doc} {

      allow read: if
        isGlobalAdmin();

      allow create: if
        isAuthenticated();

      allow update, delete: if
        false;
    }

    // ============================================================
    // 25. LOGS DO SISTEMA
    // ============================================================

    match /system_logs/{doc} {

      allow read: if
        isGlobalAdmin();

      allow create: if
        isAuthenticated();

      allow update, delete: if
        isSuperAdmin();
    }

    match /logs/{doc} {

      allow read: if
        isGlobalAdmin();

      allow create: if
        isAuthenticated();

      allow update, delete: if
        isSuperAdmin();
    }

    // ============================================================
    // 26. NEGAR TUDO QUE NÃO FOI DEFINIDO
    // ============================================================

    match /{document=**} {

      allow read, write: if
        false;
    }
  }
}
